root = true

# Silence PublicApiAnalyzers diagnostics while API baselines (PublicAPI.Shipped.txt /
# PublicAPI.Unshipped.txt) are still empty. Remove these suppressions at the v1 release gate:
# populate the baseline files, then change severity back to "error" so future public-API
# changes require explicit updates.
[*.cs]
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0017.severity = none
dotnet_diagnostic.RS0022.severity = none
dotnet_diagnostic.RS0025.severity = none
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
dotnet_diagnostic.RS0037.severity = none
