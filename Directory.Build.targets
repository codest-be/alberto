<Project>

    <!-- Properties tested against IsPackable must live here: Directory.Build.props is imported before
         the csproj sets IsPackable=true, so the same Condition there is silently false. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">

        <!-- SourceLink. ContinuousIntegrationBuild is CI-only so local builds stay non-deterministic-path and fast. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- README links must be absolute GitHub URLs: nuget.org cannot resolve relative paths. -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- NuGet accepts only PNG/JPEG; regenerate with: rsvg-convert -w 256 -h 256 icon.svg -o icon.png -->
        <PackageIcon>icon.png</PackageIcon>

        <!-- Set PackageValidationBaselineVersion once a previous release exists. -->
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <!-- Packages ship lockstep with InternalsVisibleTo: packed Alberto.* references must be exact ([x.y.z]). -->
    <Target Name="PinProjectVersionExact" AfterTargets="_GetProjectReferenceVersions" Condition="'$(IsPackable)' == 'true'">
        <ItemGroup>
            <_ProjectReferencesWithVersions ProjectVersion="[%(ProjectVersion)]" />
        </ItemGroup>
    </Target>

</Project>
