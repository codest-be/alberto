{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "graphql": {
        "ClusterId": "albertoapi",
        "AuthorizationPolicy": "Default",
        "Order": 0,
        "Match": {
          "Path": "/api/graphql"
        },
        "Transforms": [
          { "PathSet": "/graphql" },
          { "RequestHeader": "X-Tenant-Id", "Set": "admin_console" },
          { "X-Forwarded": "Set" }
        ]
      },
      "mcp-passthrough": {
        "ClusterId": "albertoapi",
        "AuthorizationPolicy": "Default",
        "Order": 0,
        "Match": {
          "Path": "/api/mcp/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "mcp-wellknown": {
        "ClusterId": "albertoapi",
        "Order": 0,
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set" }
        ]
      },
      "api": {
        "ClusterId": "albertoapi",
        "AuthorizationPolicy": "Default",
        "Order": 1,
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      }
    },
    "Clusters": {
      "albertoapi": {
        "Destinations": {
          "albertoapi": {
            "Address": "https+http://orders-api"
          }
        }
      }
    }
  }
}
