<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Alberto.Examples.Shared\Alberto.Examples.Shared.csproj" />
    <ProjectReference Include="..\Alberto.Orders\Alberto.Orders.csproj" />
    <ProjectReference Include="..\..\Alberto.Payments\Alberto.Payments\Alberto.Payments.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Telemetry\Alberto.Dcb.Telemetry.csproj" />
    <ProjectReference Include="..\..\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Admin\Alberto.Dcb.Admin.csproj" />
    <!-- AddAlbertoPostgresAdmin moved out of Alberto.Dcb.Postgres so that package would stop
         carrying an unresolvable dependency on the parked Alberto.Dcb.Admin. The namespace did
         not change, so Program.cs's usings are the same as before. -->
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Postgres.Admin\Alberto.Dcb.Postgres.Admin.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Admin.GraphQL\Alberto.Dcb.Admin.GraphQL.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Admin.Mcp\Alberto.Dcb.Admin.Mcp.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Dcb.Postgres\Alberto.Dcb.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.Subscriptions.Postgres" />
    <!--
      No HotChocolate.Types.Analyzers here: every GraphQL type now lives in a slice inside the
      Alberto.Orders and Alberto.Payments module projects, which run the analyzer themselves.
      This host only composes their generated type modules.
    -->

  </ItemGroup>

</Project>
