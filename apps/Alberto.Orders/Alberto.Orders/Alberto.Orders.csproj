<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project per module, not one per layer. A slice owns its contract, its state, its decision
    and the mutation that exposes it; splitting Core from Infrastructure would put those files in
    two assemblies and make the slice folder a lie.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Alberto.Examples.Shared\Alberto.Examples.Shared.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto\Alberto.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Commands\Alberto.Commands.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Postgres\Alberto.Postgres.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.Telemetry\Alberto.Telemetry.csproj" />
    <ProjectReference Include="..\..\..\src\Alberto.EntityFramework\Alberto.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The slices declare their own GraphQL types, so the source generator runs here. -->
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.Types.Analyzers" />
  </ItemGroup>

</Project>
