<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Dcb.EntityFramework</PackageId>
        <Title>Alberto DCB Entity Framework Integration</Title>
        <Description>Entity Framework Core integration for Alberto DCB projections. Provides proper relational columns and indexes instead of JSONB storage.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Dcb.EntityFramework</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Dcb.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto.Dcb\Alberto.Dcb.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    </ItemGroup>
</Project>
