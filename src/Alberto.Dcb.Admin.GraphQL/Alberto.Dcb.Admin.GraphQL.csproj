<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!--
            Package metadata kept for when this ships; not packable while the surface is parked.

            This whole branch is held out of 1.0 so its field names are not frozen under semver, and
            Alberto.Dcb.Admin — which this references — is IsPackable=false on main for the same
            reason. Packing this one would produce a nupkg with an unresolvable dependency.

            Unparking is one act, not four: flip IsPackable on Alberto.Dcb.Admin,
            Alberto.Dcb.Postgres.Admin, this and Alberto.Dcb.Admin.Mcp together, and capture a
            PublicAPI.Shipped.txt for each. The public-API analyzer is gated on IsPackable, so it is
            inert until then — which is why this project has no PublicAPI files yet.
        -->
        <PackageId>Alberto.Dcb.Admin.GraphQL</PackageId>
        <Title>Alberto DCB Admin - GraphQL Surface</Title>
        <Description>HotChocolate GraphQL types for the Alberto DCB admin surface. Registers admin queries, mutations, and subscriptions with any HotChocolate server.</Description>
        <IsPackable>false</IsPackable>
        <RootNamespace>Alberto.Dcb.Admin.GraphQL</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Alberto.Dcb.Admin/Alberto.Dcb.Admin.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HotChocolate.AspNetCore" />
        <PackageReference Include="HotChocolate.Subscriptions.InMemory" />
        <PackageReference Include="HotChocolate.Types.Analyzers" />
    </ItemGroup>
</Project>
