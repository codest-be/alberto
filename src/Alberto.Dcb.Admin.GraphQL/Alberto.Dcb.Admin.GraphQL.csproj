<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Dcb.Admin.GraphQL</PackageId>
        <Title>Alberto DCB Admin - GraphQL Surface</Title>
        <Description>HotChocolate GraphQL types for the Alberto DCB admin surface. Registers admin queries, mutations, and subscriptions with any HotChocolate server.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Dcb.Admin.GraphQL</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Alberto.Dcb.Admin/Alberto.Dcb.Admin.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HotChocolate.AspNetCore" />
        <PackageReference Include="HotChocolate.Subscriptions.InMemory" />
        <PackageReference Include="HotChocolate.Types.Analyzers" />
    </ItemGroup>
</Project>
