<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <PackageId>Alberto.EventStore.Postgres</PackageId>
    <Title>Alberto EventStore - PostgreSQL Implementation</Title>
    <Description>PostgreSQL implementation of Alberto EventStore for production scenarios. Provides high-performance, persistent event storage with multi-schema support and optimistic concurrency.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alberto.EventStore\Alberto.EventStore.csproj"/>
    <ProjectReference Include="..\Alberto.EventStore.Telemetry\Alberto.EventStore.Telemetry.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <PackageReference Include="Npgsql"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql"/>
  </ItemGroup>
</Project>