<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Dcb</PackageId>
        <Title>Alberto DCB Event Store</Title>
        <Description>Dynamic Consistency Boundary event store library for .NET. Provides core abstractions for event sourcing with DCB pattern.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Dcb</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Dcb.Tests"/>
        <InternalsVisibleTo Include="Alberto.Dcb.InMemory"/>
        <InternalsVisibleTo Include="Alberto.Dcb.Postgres"/>
        <InternalsVisibleTo Include="Alberto.Dcb.Messaging"/>
        <InternalsVisibleTo Include="Alberto.Dcb.EntityFramework"/>
        <InternalsVisibleTo Include="Alberto.Dcb.Telemetry"/>
        <InternalsVisibleTo Include="Alberto.Dcb.Commands"/>
        <InternalsVisibleTo Include="Alberto.Dcb.Benchmarks"/>
        <!-- The backend conformance suite asserts that a reserved _version tag round-trips and
             that tag boundaries match by containment. Constructing that tag is exactly what the
             public API forbids, so the spec needs the internal EventTag.ForVersion/FromStorage. -->
        <InternalsVisibleTo Include="Alberto.Dcb.Testing.Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="OpenTelemetry.Api"/>
    </ItemGroup>
</Project>
