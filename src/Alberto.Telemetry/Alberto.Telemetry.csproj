<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <PackageId>Alberto.Telemetry</PackageId>
    <Title>Alberto DCB Event Store - OpenTelemetry Instrumentation</Title>
    <Description>OpenTelemetry instrumentation for Alberto DCB event store. Provides traces and metrics for event processing.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Alberto.Telemetry</RootNamespace>

        <!-- Native AOT / trimming: turns on the trim, single-file and AOT analyzers (IL2xxx/IL3xxx),
             which TreatWarningsAsErrors makes build-breaking. The config binder generator replaces
             reflection-based IConfiguration.Get<T>() with source-generated binding. -->
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Alberto.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alberto\Alberto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

</Project>
