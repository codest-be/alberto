<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Postgres</PackageId>
        <Title>Alberto DCB Event Store - PostgreSQL Backend</Title>
        <Description>PostgreSQL backend for Alberto DCB event store. Uses inverted indexes for efficient DCB queries.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Postgres</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Tests"/>
        <InternalsVisibleTo Include="Alberto.Messaging.Postgres"/>
        <!-- The admin implementation was split out of this assembly so that this one can ship
             while the admin surface stays parked. It still needs the internals it used when the
             files lived here (SchemaQualifier and friends). -->
        <InternalsVisibleTo Include="Alberto.Admin.Postgres"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto\Alberto.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" />
        <PackageReference Include="DbUp-PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Migrations\*.sql" />
        <EmbeddedResource Include="Migrations\SingleTenant\*.sql" />
        <EmbeddedResource Include="Migrations\Catalog\*.sql" />
    </ItemGroup>
</Project>
