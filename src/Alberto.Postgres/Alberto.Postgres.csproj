<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Postgres</PackageId>
        <Title>Alberto DCB Event Store - PostgreSQL Backend</Title>
        <Description>PostgreSQL backend for Alberto DCB event store. Uses inverted indexes for efficient DCB queries.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Postgres</RootNamespace>

        <!-- Native AOT / trimming: turns on the trim, single-file and AOT analyzers (IL2xxx/IL3xxx),
             which TreatWarningsAsErrors makes build-breaking. The config binder generator replaces
             reflection-based IConfiguration.Get<T>() with source-generated binding. -->
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Tests"/>
        <InternalsVisibleTo Include="Alberto.Messaging.Postgres"/>
        <!-- The admin implementation was split out of this assembly so that this one can ship
             while the admin surface stays parked. It still needs the internals it used when the
             files lived here (SchemaQualifier and friends). -->
        <InternalsVisibleTo Include="Alberto.Admin.Postgres"/>
        <!-- The tenant-scoped concurrency benchmarks construct PostgresTenantEventStoreBackend
             directly — its real per-tenant lock key with none of the DI/module-builder wiring
             a full .WithTenancy() module would need. See
             benchmarks/Alberto.Benchmarks/Workloads/ConcurrentAppendBenchmarks.cs. -->
        <InternalsVisibleTo Include="Alberto.Benchmarks"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto\Alberto.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" />
        <PackageReference Include="DbUp-PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Migrations\*.sql" />
        <EmbeddedResource Include="Migrations\SingleTenant\*.sql" />
        <EmbeddedResource Include="Migrations\Catalog\*.sql" />
    </ItemGroup>
</Project>
