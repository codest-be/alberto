<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The PostgreSQL implementation of the admin surface. Deliberately NOT packable.

        The admin surface is held out of 1.0 so its shape is not frozen by semver: the GraphQL
        admin API, MCP server, React console and BFF that consume it live on feature/admin-surface,
        and freezing IAdminReader/IAdminOperator before those exist would fix the wrong contract.
        The only consumer on main is tools/Alberto.Cli, which references this project directly.

        This project exists at all because Alberto.Dcb.Postgres IS packable. These three files used
        to live there, which meant its nupkg carried a dependency on Alberto.Dcb.Admin and exposed
        33 public members returning Alberto.Dcb.Admin types. Parking Alberto.Dcb.Admin without
        moving them would have shipped a package with an unresolvable dependency. Splitting them
        out is what lets both stay unpackaged while Alberto.Dcb.Postgres ships clean.

        Note there is no PublicAPI.*.txt here, and that is not an omission: the public-API gate in
        Directory.Build.props is conditioned on IsPackable, so a non-packable project has no
        surface to freeze. Nothing about this assembly is under semver until it is unparked.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Alberto.Dcb.Postgres</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Dcb.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto.Dcb\Alberto.Dcb.csproj" />
        <ProjectReference Include="..\Alberto.Dcb.Admin\Alberto.Dcb.Admin.csproj" />
        <ProjectReference Include="..\Alberto.Dcb.Postgres\Alberto.Dcb.Postgres.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" />
    </ItemGroup>
</Project>
