<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Dcb.Commands</PackageId>
        <Title>Alberto DCB Command Pipeline</Title>
        <Description>Fluent command pipeline for Alberto DCB. Composes validate → load → decide → persist workflows over a dynamic consistency boundary, with automatic retry on append conflicts.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Commands</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Dcb.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto.Dcb\Alberto.Dcb.csproj"/>
        <!-- Build-order only. The analyzer targets netstandard2.0 and is not a dependency of this
             assembly, so nothing of it is referenced or flowed to consumers; PackAnalyzer below is
             what actually puts it in the package. Without this the analyzer is simply not built
             before pack asks GetTargetPath where its output is, and pack fails on the missing
             directory. -->
        <ProjectReference Include="..\Alberto.Dcb.Commands.Analyzers\Alberto.Dcb.Commands.Analyzers.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <!-- Ship DiscardedPipelineAnalyzer (ALB2001) with the package. Consumers get it automatically:
         NuGet treats anything under analyzers/dotnet/cs as an analyzer reference, so a dropped
         pipeline is a build warning without the consumer configuring anything.

         GetTargetPath is asked for the path rather than hardcoding an obj/bin layout, so this keeps
         working under artifacts-style output paths. BeforeTargets="_GetPackageFiles" is the point
         at which pack collects None items — adding to @(None) any later has no effect. -->
    <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="..\Alberto.Dcb.Commands.Analyzers\Alberto.Dcb.Commands.Analyzers.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_AlbertoAnalyzerAssembly"/>
        </MSBuild>
        <ItemGroup>
            <None Include="@(_AlbertoAnalyzerAssembly)"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs"
                  Visible="false"/>
        </ItemGroup>
    </Target>
</Project>
