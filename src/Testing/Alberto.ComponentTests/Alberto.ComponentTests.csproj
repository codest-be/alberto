<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <PackageId>Alberto.Testing.ComponentTests</PackageId>
    <Title>Alberto Testing - Component Tests Framework</Title>
    <Description>Reusable component testing framework for Alberto EventStore applications. Provides fluent API for building integration tests with Arrange-Act-Assert pattern, step-based architecture, and WebApplicationFactory support.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
  </ItemGroup>

</Project>
