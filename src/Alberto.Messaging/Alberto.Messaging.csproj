<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Package Metadata -->
        <PackageId>Alberto.Messaging</PackageId>
        <Title>Alberto DCB Event Store - Messaging / Outbox</Title>
        <Description>Transactional outbox pattern for Alberto DCB event store. Reliably publishes domain events as external messages to any transport.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Alberto.Messaging</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alberto.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alberto\Alberto.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>
</Project>
