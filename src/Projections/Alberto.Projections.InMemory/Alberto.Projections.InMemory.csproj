<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <PackageId>Alberto.Projections.InMemory</PackageId>
    <Title>Alberto Projections - In-Memory Implementation</Title>
    <Description>In-memory implementation of Alberto projection repositories for development, testing, and low-scale production scenarios. Thread-safe and high-performance.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alberto.Projections\Alberto.Projections.csproj"/>
  </ItemGroup>
</Project>
