<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- netstandard2.0 is not a choice: Roslyn loads analyzers into the compiler process,
             which is what dictates the target framework. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- Not a package of its own: the assembly is packed into Alberto.Dcb.Commands under
             analyzers/dotnet/cs by that project's PackAnalyzer target. IsPackable=false also keeps
             the SourceLink and PublicApiAnalyzers item groups in Directory.Build.props from
             applying — an analyzer has no public API surface worth freezing. -->
        <IsPackable>false</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile-time only. The version is the *lowest* Roslyn the analyzer needs rather than
             the newest available: analyzers bind forward to whatever Roslyn the consumer's SDK
             loads them into, but not backward. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>
</Project>
