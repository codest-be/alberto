<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Versioned with the runtime, so declared once per target framework: a net10 consumer stays on
       10.x and a net11 consumer gets 11.x. EF Core 11 ships for net11.0 alone, so one version for
       both targets is not an option for it, and the rest follow the same rule rather than mixing
       runtime trains inside one build. Anything not net11.0 (net10.0, netstandard2.0) takes 10.x.
       Dependabot ignores majors here; a new .NET major is added by hand as a new group. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core Dependencies -->
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.21.0-rc.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <!-- CLI Tool -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- PostgreSQL -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="DbUp-PostgreSQL" Version="7.0.1" />
    <!-- Entity Framework -->
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.6.5" />
    <!-- GraphQL -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="15.1.15" />
    <PackageVersion Include="HotChocolate.AspNetCore.CommandLine" Version="15.1.15" />
    <PackageVersion Include="HotChocolate.Diagnostics" Version="15.1.15" />
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="15.1.15" />
    <PackageVersion Include="HotChocolate.Subscriptions.Postgres" Version="15.1.15" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="15.1.15" />
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Service Defaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <!-- BFF -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <!-- Rebus (test-only; not shipped in any packable project) -->
    <PackageVersion Include="Rebus" Version="8.10.0" />
    <PackageVersion Include="Rebus.PostgreSql" Version="9.1.1" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Packaging / Source quality (applied only to packable src/ projects via Directory.Build.props) -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <!-- Roslyn, for the analyzer shipped inside Alberto.Commands. Pinned to the oldest version
         exposing the IOperation APIs the analyzer uses: an analyzer binds forward to whatever
         Roslyn the consumer's SDK hosts it in, never backward, so a newer reference here would
         only narrow the range of SDKs that can load it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.1.0" />
  </ItemGroup>
</Project>