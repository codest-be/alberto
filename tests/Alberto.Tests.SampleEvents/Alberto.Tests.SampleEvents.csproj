<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Alberto/Alberto.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- In-repo projects get the generator by reference; package consumers get it from analyzers/. -->
        <ProjectReference Include="../../src/Alberto.SourceGeneration/Alberto.SourceGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
