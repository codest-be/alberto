<Project>
    <PropertyGroup>
        <!-- Package Information -->
        <Authors>Bjorn Vandenbussche</Authors>
        <Company>Codest</Company>
        <Product>Alberto DCB Event Store</Product>
        <Copyright>Copyright © 2025 Alberto</Copyright>

        <!-- Version -->
        <VersionPrefix>0.1.4</VersionPrefix>

        <!-- Repository Information -->
        <RepositoryUrl>https://github.com/codest-be/alberto</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Package Configuration -->
        <PackageProjectUrl>https://github.com/codest-be/alberto</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>DCB;events;eventsourcing;dotnet;postgresql;dynamic-consistency-boundary</PackageTags>

        <!-- Build Configuration -->

        <!-- Nothing ships to NuGet unless it says so. The SDK default is the other way round, which
             quietly handed the package metadata, SourceLink and the public-API gate below to every
             app, test, tool and benchmark project in the repo. Each package under /src sets
             IsPackable=true in its own PropertyGroup, and a csproj body is evaluated after this
             file, so opting in still works exactly as before. -->
        <IsPackable>false</IsPackable>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (missing XML doc) is suppressed until the public surface is fully documented.
             Remove this suppression and fix all missing-doc warnings before a stable v1 release. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- Packable-only *properties* live in Directory.Build.targets, not here. MSBuild evaluates
         every property in file-import order before it evaluates any item, so a PropertyGroup in
         this file guarded on '$(IsPackable)' == 'true' is tested while IsPackable is still the
         false set above — the csproj body that flips it has not been read yet. Such a group is
         silently dead. Items are different: the ItemGroup below is evaluated in a later pass, by
         which time IsPackable is true, so guarding items here works and is deliberate. -->

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <!-- README.md lives at the repo root; PackagePath="\" places it at the nupkg root
             where NuGet gallery tooling looks for it. Same for the package icon — both are
             named by properties in Directory.Build.targets, which is where they have to be
             set (see the comment at the top of that file). -->
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />

        <!-- SourceLink — PrivateAssets="All" keeps this dev-time reference out of the dependency
             graph that consumers see; it is compile-time only. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

        <!-- Public API surface tracking — every public type and member must appear in this
             project's PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so adding or removing one
             is a reviewable diff rather than something that slips out in a patch release. The
             rules are at error severity (see .editorconfig); the build fails on an undeclared
             symbol. PrivateAssets="All" because this is a build-time analyzer only. -->
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />

        <!-- Wire the per-project declaration files as additional inputs to the analyzer. The
             Condition guards prevent a misleading "file not found" diagnostic during the window
             before the files exist — though they should always exist once the project is checked
             out because every packable project commits both. -->
        <AdditionalFiles Include="PublicAPI.Shipped.txt"   Condition="Exists('PublicAPI.Shipped.txt')" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
    </ItemGroup>
</Project>
