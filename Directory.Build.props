<Project>
    <PropertyGroup>
        <!-- Package Information -->
        <Authors>Bjorn Vandenbussche</Authors>
        <Company>Codest</Company>
        <Product>Alberto DCB Event Store</Product>
        <Copyright>Copyright © 2025 Alberto</Copyright>

        <!-- Version -->
        <VersionPrefix>0.1.0</VersionPrefix>

        <!-- Repository Information -->
        <RepositoryUrl>https://github.com/codest-be/albertoo</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Package Configuration -->
        <PackageProjectUrl>https://github.com/codest-be/albertoo</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>DCB;events;eventsourcing;dotnet;postgresql;dynamic-consistency-boundary</PackageTags>

        <!-- Build Configuration -->

        <!-- Nothing ships to NuGet unless it says so. The SDK default is the other way round, which
             quietly handed the package metadata, SourceLink and the public-API gate below to every
             app, test, tool and benchmark project in the repo. Each package under /src sets
             IsPackable=true in its own PropertyGroup, and a csproj body is evaluated after this
             file, so opting in still works exactly as before. -->
        <IsPackable>false</IsPackable>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (missing XML doc) is suppressed until the public surface is fully documented.
             Remove this suppression and fix all missing-doc warnings before a stable v1 release. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- SourceLink — embeds a source-server pointer into the .pdb so debuggers can step into
         library source straight from nuget.org. Only meaningful on packable projects; non-packable
         projects (apps, tests, tools) produce no .snupkg and need none of this.
         ContinuousIntegrationBuild is gated on the CI env-var so local dev builds stay fast and
         the compiler does not try to make paths deterministic on a developer machine. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!--
            README is at the repo root; each packable project in src/ is one level below the solution
            root, so the relative path from the project file is ../../README.md. Directory.Build.props
            uses $(MSBuildThisFileDirectory) (= the repo root) so the absolute path is correct for the
            None Include in the ItemGroup below.
        -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
            TODO (human task — cannot be authored here): icon.png
            Once a square PNG icon (128×128 or 256×256) is committed to the repo root:
              <PackageIcon>icon.png</PackageIcon>
            and add the following None Include to the ItemGroup below:
              <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
        -->
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <!-- README.md lives at the repo root; PackagePath="\" places it at the nupkg root
             where NuGet gallery tooling looks for it. -->
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />

        <!-- SourceLink — PrivateAssets="All" keeps this dev-time reference out of the dependency
             graph that consumers see; it is compile-time only. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

        <!-- Public API surface tracking — every public type and member must appear in this
             project's PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so adding or removing one
             is a reviewable diff rather than something that slips out in a patch release. The
             rules are at error severity (see .editorconfig); the build fails on an undeclared
             symbol. PrivateAssets="All" because this is a build-time analyzer only. -->
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />

        <!-- Wire the per-project declaration files as additional inputs to the analyzer. The
             Condition guards prevent a misleading "file not found" diagnostic during the window
             before the files exist — though they should always exist once the project is checked
             out because every packable project commits both. -->
        <AdditionalFiles Include="PublicAPI.Shipped.txt"   Condition="Exists('PublicAPI.Shipped.txt')" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
    </ItemGroup>
</Project>
