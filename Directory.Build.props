<Project>
    <PropertyGroup>
        <!-- Package Information -->
        <Authors>Bjorn Vandenbussche</Authors>
        <Company>Codest</Company>
        <Product>Alberto DCB Event Store</Product>
        <Copyright>Copyright © 2025 Alberto</Copyright>

        <!-- Version -->
        <VersionPrefix>0.1.0</VersionPrefix>

        <!-- Repository Information -->
        <RepositoryUrl>https://github.com/codest-be/albertoo</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Package Configuration -->
        <PackageProjectUrl>https://github.com/codest-be/albertoo</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>DCB;events;eventsourcing;dotnet;postgresql;dynamic-consistency-boundary</PackageTags>

        <!-- Build Configuration -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (missing XML doc) is suppressed until the public surface is fully documented.
             Remove this suppression and fix all missing-doc warnings before a stable v1 release. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- SourceLink — embeds a source-server pointer into the .pdb so debuggers can step into
         library source straight from nuget.org. Only meaningful on packable projects; non-packable
         projects (apps, tests, tools) produce no .snupkg and need none of this.
         ContinuousIntegrationBuild is gated on the CI env-var so local dev builds stay fast and
         the compiler does not try to make paths deterministic on a developer machine. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!--
            README is at the repo root; each packable project in src/ is one level below the solution
            root, so the relative path from the project file is ../../README.md. Directory.Build.props
            uses $(MSBuildThisFileDirectory) (= the repo root) so the absolute path is correct for the
            None Include in the ItemGroup below.
        -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
            TODO (human task — cannot be authored here): icon.png
            Once a square PNG icon (128×128 or 256×256) is committed to the repo root:
              <PackageIcon>icon.png</PackageIcon>
            and add the following None Include to the ItemGroup below:
              <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
        -->
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <!-- README.md lives at the repo root; PackagePath="\" places it at the nupkg root
             where NuGet gallery tooling looks for it. -->
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />

        <!-- SourceLink — PrivateAssets="All" keeps this dev-time reference out of the dependency
             graph that consumers see; it is compile-time only. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

        <!-- Public API surface tracking — enforces that intentional additions/removals to the
             public API are captured in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt.
             PrivateAssets="All" because this is a build-time analyzer only.
             RulesNotAsErrors below keeps this from failing the build while the initial baselines
             are still empty; raise those rules to 'error' when capturing the v1 baseline. -->
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />

        <!-- Wire the per-project declaration files as additional inputs to the analyzer. The
             Condition guards prevent a misleading "file not found" diagnostic during the window
             before the files exist — though they should always exist once the project is checked out
             because we committed them as empty files. -->
        <AdditionalFiles Include="PublicAPI.Shipped.txt"   Condition="Exists('PublicAPI.Shipped.txt')" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />

        <!-- Silence all PublicApiAnalyzer diagnostics via a global analyzer config so that they
             apply to source-generated files (in obj/) as well as regular source files. The .editorconfig
             suppression at the repo root works for regular source but not for all source-generator
             output paths in every TFM. GlobalAnalyzerConfigFiles is the reliable alternative.
             TODO (v1 release gate): remove this file reference and re-enable the diagnostics. -->
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)publicapi-silence.globalconfig"
                                   Condition="Exists('$(MSBuildThisFileDirectory)publicapi-silence.globalconfig')" />
    </ItemGroup>

    <!-- Silence PublicApiAnalyzers diagnostics until the v1 baselines are captured.
         These rules track every deviation between the live public surface and the committed
         baseline files (PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt).
           RS0016 — public type/member not in declared API
           RS0017 — declared API entry that no longer exists
           RS0022 — constructor makes a non-inheritable base class inheritable
           RS0025 — symbol duplicated across Shipped/Unshipped
           RS0026 — multiple public overloads with optional parameters
           RS0027 — overload with optional params should have the most params
           RS0037 — nullability of reference types not tracked in declared API
         The analyzer emits RS0016 as an error (not a warning), so WarningsNotAsErrors has no
         effect; NoWarn is required to silence it while baselines are empty.
         TODO (v1 release gate): remove this PropertyGroup, capture the baselines into each
         project's PublicAPI.Unshipped.txt, then set all RS00xx rules to severity 'error' in
         .editorconfig so future public API changes require explicit declaration updates. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <NoWarn>$(NoWarn);RS0016;RS0017;RS0022;RS0025;RS0026;RS0027;RS0037</NoWarn>
    </PropertyGroup>
</Project>
