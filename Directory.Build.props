<Project>
    <PropertyGroup>
        <!-- Package Information -->
        <Authors>Bjorn Vandenbussche</Authors>
        <Company>Codest</Company>
        <Product>Alberto DCB Event Store</Product>
        <Copyright>Copyright © 2025 Alberto</Copyright>

        <!-- Version -->
        <VersionPrefix>0.1.0</VersionPrefix>

        <!-- Repository Information -->
        <RepositoryUrl>https://github.com/codest-be/albertoo</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Package Configuration -->
        <PackageProjectUrl>https://github.com/codest-be/albertoo</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>DCB;events;eventsourcing;dotnet;postgresql;dynamic-consistency-boundary</PackageTags>

        <!-- Build Configuration -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
</Project>
