<Project>
    <PropertyGroup>
        <!-- Package Information -->
        <Authors>Bjorn Vandenbussche</Authors>
        <Company>Codest</Company>
        <Product>Alberto DCB Event Store</Product>
        <Copyright>Copyright © $([System.DateTime]::UtcNow.Year) Alberto</Copyright>

        <!-- Version -->
        <VersionPrefix>0.11.0</VersionPrefix>

        <!-- Repository Information -->
        <RepositoryUrl>https://github.com/codest-be/alberto</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Package Configuration -->
        <PackageProjectUrl>https://github.com/codest-be/alberto</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>DCB;events;eventsourcing;dotnet;postgresql;dynamic-consistency-boundary</PackageTags>

        <!-- Build Configuration -->
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Every library under /src ships for both. Benchmarks and tests run on
             net10.0 only: they are consumers of one runtime, not the thing being shipped. -->
        <AlbertoLibraryTargetFrameworks>net10.0;net11.0</AlbertoLibraryTargetFrameworks>

        <!-- Opt-in: each package under /src sets IsPackable=true in its own csproj. -->
        <IsPackable>false</IsPackable>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (missing XML doc) is suppressed until the public surface is fully documented. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- Packable-only properties go in Directory.Build.targets: a property group guarded on IsPackable here is evaluated before the csproj sets it and is silently dead. Items are evaluated later, so the ItemGroup below works. -->

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <!-- Packed at the nupkg root; named by PackageReadmeFile/PackageIcon in Directory.Build.targets. -->
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />

        <!-- SourceLink; build-time only. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

        <!-- Public API tracking: every public symbol must be in the project's PublicAPI.*.txt (errors per .editorconfig). -->
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />

        <!-- Feed the per-project declaration files to the analyzer. -->
        <AdditionalFiles Include="PublicAPI.Shipped.txt"   Condition="Exists('PublicAPI.Shipped.txt')" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
    </ItemGroup>
</Project>
